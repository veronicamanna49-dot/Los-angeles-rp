const { ModalBuilder, TextInputBuilder, TextInputStyle, ActionRowBuilder, EmbedBuilder, PermissionFlagsBits, ButtonBuilder, ButtonStyle } = require('discord.js');

const TICKET_STAFF_ROLE_ID = "1537065637975695432";
const VERIFIED_ROLE_ID = "INSERISCI_ID_RUOLO_VERIFICATO_QUI";

module.exports = {
    name: 'interactionCreate',
    async execute(interaction, client) {

        // --- MODULO VERIFICA ROBLOX ---
        if (interaction.isButton() && interaction.customId === 'btn_verify') {
            const modal = new ModalBuilder()
                .setCustomId('modal_verify')
                .setTitle('Verifica Account Roblox');

            const robloxInput = new TextInputBuilder()
                .setCustomId('roblox_username')
                .setLabel("Inserisci il tuo Nickname Roblox")
                .setStyle(TextInputStyle.Short)
                .setPlaceholder("Es: RobloxUser123")
                .setRequired(true);

            modal.addComponents(new ActionRowBuilder().addComponents(robloxInput));
            await interaction.showModal(modal);
        }

        if (interaction.isFromModal() && interaction.customId === 'modal_verify') {
            await interaction.deferReply({ ephemeral: true });
            const robloxUsername = interaction.fields.getTextInputValue('roblox_username');

            try {
                const response = await fetch('https://users.roblox.com/v1/usernames/users', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ usernames: [robloxUsername], excludeBannedUsers: true })
                });

                const data = await response.json();

                if (!data.data || data.data.length === 0) {
                    return await interaction.editReply({ content: `❌ L'utente Roblox **${robloxUsername}** non esiste.` });
                }

                const realRobloxName = data.data[0].name;
                const newNickname = `${interaction.user.username} | ${realRobloxName}`;
                const finalNickname = newNickname.length > 32 ? newNickname.substring(0, 32) : newNickname;

                try {
                    await interaction.member.setNickname(finalNickname);
                } catch (err) {}

                if (VERIFIED_ROLE_ID && VERIFIED_ROLE_ID !== "INSERISCI_ID_RUOLO_VERIFICATO_QUI") {
                    await interaction.member.roles.add(VERIFIED_ROLE_ID).catch(() => {});
                }

                await interaction.editReply({ content: `✅ **Verifica completata!** Account **${realRobloxName}** collegato.` });
            } catch (error) {
                console.error(error);
                await interaction.editReply({ content: "⚠️ Errore durante la verifica Roblox." });
            }
        }

        // --- MODULO TICKET ---
        if (interaction.isButton() && interaction.customId === 'btn_open_ticket') {
            const guild = interaction.guild;
            const user = interaction.user;

            const existingChannel = guild.channels.cache.find(c => c.name === `ticket-${user.username.toLowerCase()}`);
            if (existingChannel) {
                return interaction.reply({ content: `⚠️ Hai già un ticket aperto in ${existingChannel}!`, ephemeral: true });
            }

            await interaction.deferReply({ ephemeral: true });

            try {
                const ticketChannel = await guild.channels.create({
                    name: `ticket-${user.username}`,
                    type: 0,
                    permissionOverwrites: [
                        { id: guild.id, deny: [PermissionFlagsBits.ViewChannel] },
                        { id: user.id, allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.AttachFiles] },
                        { id: TICKET_STAFF_ROLE_ID, allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.AttachFiles] },
                    ],
                });

                const embed = new EmbedBuilder()
                    .setTitle(`Ticket di ${user.username}`)
                    .setDescription("Benvenuto! Spiega il tuo problema in dettaglio.")
                    .setColor(0x2ECC71);

                const closeButton = new ActionRowBuilder().addComponents(
                    new ButtonBuilder()
                        .setCustomId('btn_close_ticket')
                        .setLabel('Chiudi Ticket')
                        .setEmoji('🔒')
                        .setStyle(ButtonStyle.Danger)
                );

                await ticketChannel.send({ content: `<@${user.id}> | <@&${TICKET_STAFF_ROLE_ID}>`, embeds: [embed], components: [closeButton] });
                await interaction.editReply({ content: `✅ Ticket creato in ${ticketChannel}!` });
            } catch (error) {
                console.error(error);
                await interaction.editReply({ content: "❌ Impossibile creare il ticket." });
            }
        }

        if (interaction.isButton() && interaction.customId === 'btn_close_ticket') {
            await interaction.reply("🔒 Il ticket verrà eliminato tra 5 secondi...");
            setTimeout(() => {
                interaction.channel.delete().catch(() => {});
            }, 5000);
        }
    }
};
